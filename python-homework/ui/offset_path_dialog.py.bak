#!/usr/bin/env python3
# -*- coding: utf-8 -*-

from PyQt5.QtWidgets import (QDialog, QVBoxLayout, QHBoxLayout, QLabel, 
                             QLineEdit, QRadioButton, QPushButton, QCheckBox, 
                             QGroupBox, QButtonGroup, QWidget)
from PyQt5.QtCore import Qt

class OffsetPathDialog(QDialog):
    def __init__(self, parent=None):
        super().__init__(parent)
        self.setWindowTitle("生成平行线")
        self.resize(320, 200) # Compact size as requested
        self.setFixedSize(320, 240) 

        layout = QVBoxLayout(self)
        layout.setContentsMargins(10, 10, 10, 10)
        layout.setSpacing(10)

        # 1. Offset Distance & Delete Original Row
        row1 = QHBoxLayout()
        row1.addWidget(QLabel("偏移距离"))
        
        self.offset_edit = QLineEdit("0")
        self.offset_edit.setFixedWidth(60)
        row1.addWidget(self.offset_edit)
        
        row1.addWidget(QLabel("mm"))
        row1.addStretch()
        
        self.check_delete_original = QCheckBox("删除原图")
        row1.addWidget(self.check_delete_original)
        
        layout.addLayout(row1)
        
        # 2. Separator / Line (Optional, or just GroupBox)
        # Using GroupBox for the radio buttons section
        
        self.bg = QButtonGroup(self)
        
        # We can implement the layout inside a frame or just use a layout
        # Screenshot 2 shows a separator line. QFrame can do that but GroupBox is easier.
        
        # To match the screenshot style (Custom layout with line):
        # But QGroupBox is standard.
        # Let's try to mimic the screenshot: 
        #   [ Radio buttons laid out in 2x2 grid ]
        
        mode_group = QGroupBox()
        mode_layout = QVBoxLayout(mode_group)
        mode_layout.setContentsMargins(10, 10, 10, 10)
        
        grid = QHBoxLayout() # Actually it looks like a grid or just 2 columns
        
        col1 = QVBoxLayout()
        col2 = QVBoxLayout()
        
        self.rb_inside = QRadioButton("内缩")
        self.rb_outside = QRadioButton("外扩")
        
        # The screenshot has:
        # Col 1: Inside, Outside
        # Col 2: Auto, Inside+Outside
        
        col1.addWidget(self.rb_inside)
        col1.addWidget(self.rb_outside)
        
        self.rb_auto = QRadioButton("自动内缩外扩")
        self.rb_both = QRadioButton("内缩+外扩")
        self.rb_both.setChecked(True) # Default from screenshot 5, or user request? 
        # Screenshot 2 shows "Inside" checked? No, Screenshot 2 shows "Inside" checked. 
        # Wait, let's use a sensible default. Outside is common.
        # User screenshot 2 has "内缩" (Inside) selected.
        # User screenshot 6 has "内缩+外扩" selected.
        self.rb_auto.setChecked(True) # Let's default to Auto as it is smart.

        col2.addWidget(self.rb_auto)
        col2.addWidget(self.rb_both)
        
        grid.addLayout(col1)
        grid.addLayout(col2)
        
        mode_layout.addLayout(grid)
        layout.addWidget(mode_group)
        
        # 3. Rounded Corners
        self.check_round_corners = QCheckBox("圆弧过渡")
        layout.addWidget(self.check_round_corners)
        
        # 4. Buttons
        btn_layout = QHBoxLayout()
        btn_layout.addStretch()
        
        self.btn_ok = QPushButton("确定")
        self.btn_ok.clicked.connect(self.accept)
        btn_layout.addWidget(self.btn_ok)
        
        self.btn_cancel = QPushButton("取消")
        self.btn_cancel.clicked.connect(self.reject)
        btn_layout.addWidget(self.btn_cancel)
        
        layout.addLayout(btn_layout)
        
        # Add buttons to group
        self.bg.addButton(self.rb_inside)
        self.bg.addButton(self.rb_outside)
        self.bg.addButton(self.rb_auto)
        self.bg.addButton(self.rb_both)

    def get_data(self):
        try:
            dist = float(self.offset_edit.text())
        except ValueError:
            dist = 0.0
            
        mode = "both"
        if self.rb_inside.isChecked(): mode = "inside"
        elif self.rb_outside.isChecked(): mode = "outside"
        elif self.rb_auto.isChecked(): mode = "auto"
        
        return {
            "distance": dist,
            "delete_original": self.check_delete_original.isChecked(),
            "mode": mode,
            "round_corners": self.check_round_corners.isChecked()
        }
